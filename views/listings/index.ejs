<% layout("../layouts/boilerplate") %>

<div class="filters-main">
  <div class="filters-scroll-wrapper">
    <button class="filter-arrow-btn d-none d-md-flex" id="slideLeftBtn" aria-label="Slide left">
      <i class="fa-solid fa-chevron-left"></i>
    </button>
    <div id="filters">
      <a href="/listings" class="filter <%= !selectedCategory || selectedCategory === 'All' ? 'filter-active' : '' %>">
        <div><i class="fa-solid fa-border-all"></i></div>
        <p>All</p>
      </a>
      <a href="<%= selectedCategory === 'Trending' ? '/listings' : '/listings?category=Trending' %>" class="filter <%= selectedCategory === 'Trending' ? 'filter-active' : '' %>">
        <div><i class="fa-solid fa-fire"></i></div>
        <p>Trending</p>
      </a>
      <a href="<%= selectedCategory === 'Rooms' ? '/listings' : '/listings?category=Rooms' %>" class="filter <%= selectedCategory === 'Rooms' ? 'filter-active' : '' %>">
        <div><i class="fa-solid fa-bed"></i></div>
        <p>Rooms</p>
      </a>
      <a href="<%= selectedCategory === 'Iconic cities' ? '/listings' : '/listings?category=Iconic+cities' %>" class="filter <%= selectedCategory === 'Iconic cities' ? 'filter-active' : '' %>">
        <div><i class="fa-solid fa-mountain-city"></i></div>
        <p>Iconic cities</p>
      </a>
      <a href="<%= selectedCategory === 'Mountains' ? '/listings' : '/listings?category=Mountains' %>" class="filter <%= selectedCategory === 'Mountains' ? 'filter-active' : '' %>">
        <div><i class="fa-solid fa-mountain-sun"></i></div>
        <p>Mountains</p>
      </a>
      <a href="<%= selectedCategory === 'Castles' ? '/listings' : '/listings?category=Castles' %>" class="filter <%= selectedCategory === 'Castles' ? 'filter-active' : '' %>">
        <div><i class="fa-brands fa-fort-awesome"></i></div>
        <p>Castles</p>
      </a>
      <a href="<%= selectedCategory === 'Amazing Pools' ? '/listings' : '/listings?category=Amazing+Pools' %>" class="filter <%= selectedCategory === 'Amazing Pools' ? 'filter-active' : '' %>">
        <div><i class="fa-solid fa-water-ladder"></i></div>
        <p>Amazing Pools</p>
      </a>
      <a href="<%= selectedCategory === 'Camping' ? '/listings' : '/listings?category=Camping' %>" class="filter <%= selectedCategory === 'Camping' ? 'filter-active' : '' %>">
        <div><i class="fa-solid fa-tents"></i></div>
        <p>Camping</p>
      </a>
      <a href="<%= selectedCategory === 'Farms' ? '/listings' : '/listings?category=Farms' %>" class="filter <%= selectedCategory === 'Farms' ? 'filter-active' : '' %>">
        <div><i class="fa-solid fa-seedling"></i></div>
        <p>Farms</p>
      </a>
      <a href="<%= selectedCategory === 'Arctic' ? '/listings' : '/listings?category=Arctic' %>" class="filter <%= selectedCategory === 'Arctic' ? 'filter-active' : '' %>">
        <div><i class="fa-solid fa-snowflake"></i></div>
        <p>Arctic</p>
      </a>
      <a href="<%= selectedCategory === 'Beachfront' ? '/listings' : '/listings?category=Beachfront' %>" class="filter <%= selectedCategory === 'Beachfront' ? 'filter-active' : '' %>">
        <div><i class="fa-solid fa-umbrella-beach"></i></div>
        <p>Beachfront</p>
      </a>
      <a href="<%= selectedCategory === 'Cabins' ? '/listings' : '/listings?category=Cabins' %>" class="filter <%= selectedCategory === 'Cabins' ? 'filter-active' : '' %>">
        <div><i class="fa-solid fa-house-chimney-window"></i></div>
        <p>Cabins</p>
      </a>
      <a href="<%= selectedCategory === 'Lakefront' ? '/listings' : '/listings?category=Lakefront' %>" class="filter <%= selectedCategory === 'Lakefront' ? 'filter-active' : '' %>">
        <div><i class="fa-solid fa-water"></i></div>
        <p>Lakefront</p>
      </a>
      <a href="<%= selectedCategory === 'Domes' ? '/listings' : '/listings?category=Domes' %>" class="filter <%= selectedCategory === 'Domes' ? 'filter-active' : '' %>">
        <div><i class="fa-solid fa-igloo"></i></div>
        <p>Domes</p>
      </a>
      <a href="<%= selectedCategory === 'Boats' ? '/listings' : '/listings?category=Boats' %>" class="filter <%= selectedCategory === 'Boats' ? 'filter-active' : '' %>">
        <div><i class="fa-solid fa-ship"></i></div>
        <p>Boats</p>
      </a>
    </div>
    <button class="filter-arrow-btn d-none d-md-flex" id="slideRightBtn" aria-label="Slide right">
      <i class="fa-solid fa-chevron-right"></i>
    </button>
  </div>

  <div class="tax-toggle">
    <div class="form-check-reverse form-switch">
      <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckDefault">
      <label class="form-check-label" for="flexSwitchCheckDefault">Display total after taxes</label>
    </div>
  </div>
</div>

<% if (typeof search !== 'undefined' && search) { %>
  <div class="active-filter-banner mt-3 d-flex align-items-center justify-content-between">
    <span class="text-muted">
      Search results for "<strong><%= search %></strong>" (<%= allListings.length %> <%= allListings.length === 1 ? 'listing' : 'listings' %>)
    </span>
    <a href="/listings" class="btn btn-sm btn-outline-secondary clear-filter-btn">
      <i class="fa-solid fa-xmark me-1"></i> Clear search
    </a>
  </div>
<% } else if (selectedCategory && selectedCategory !== 'All') { %>
  <div class="active-filter-banner mt-3 d-flex align-items-center justify-content-between">
    <span class="text-muted">
      Showing stays for <strong><%= selectedCategory %></strong> (<%= allListings.length %> <%= allListings.length === 1 ? 'listing' : 'listings' %>)
    </span>
    <a href="/listings" class="btn btn-sm btn-outline-secondary clear-filter-btn">
      <i class="fa-solid fa-xmark me-1"></i> Clear filter
    </a>
  </div>
<% } %>

<% if (allListings && allListings.length > 0) { %>
  <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
    <% for(let listing of allListings) { %>
      <a href="/listings/<%= listing._id %>" class="listing-link">
        <div class="card col listing-card">
          <img 
            src="<%= listing.image && listing.image.url ? listing.image.url : listing.image %>" 
            class="card-img-top" 
            alt="listing_image" 
            style="height: 20rem; object-fit: cover;"
          >
          <div class="card-img-overlay"></div>
          <div class="card-body">
            <p class="card-text">
              <b><%= listing.title %></b> <br>
              <span class="text-muted"><%= listing.location %>, <%= listing.country %></span> <br>
              <span class="price-info">
                <span class="base-price">&#8377; <%= listing.price ? Number(listing.price).toLocaleString("en-IN") : 0 %></span>
                <span class="tax-price d-none">&#8377; <%= listing.price ? Number(Math.round(listing.price * 1.18)).toLocaleString("en-IN") : 0 %></span>
                <span class="per-night"> / night</span>
                <i class="tax-info">&nbsp; &nbsp;(including 18% GST)</i>
              </span>
            </p>
          </div>
        </div>
      </a>
    <% } %>
  </div>
<% } else { %>
  <div class="col-12 text-center my-5 py-5 empty-listings-state">
    <div class="mb-3">
      <i class="fa-regular fa-compass fa-3x text-muted"></i>
    </div>
    <h4>No stays found<%= typeof search !== 'undefined' && search ? ' for "' + search + '"' : (selectedCategory && selectedCategory !== 'All' ? ' in ' + selectedCategory : '') %></h4>
    <p class="text-muted">Try adjusting your search or category filter to find what you're looking for.</p>
    <a href="/listings" class="btn btn-dark mt-2 px-4 py-2">View all listings</a>
  </div>
<% } %>

<script>
  const taxSwitch = document.getElementById("flexSwitchCheckDefault");
  if (taxSwitch) {
    taxSwitch.addEventListener("click", () => {
      const taxInfo = document.getElementsByClassName("tax-info");
      const basePrices = document.getElementsByClassName("base-price");
      const taxPrices = document.getElementsByClassName("tax-price");
      const isChecked = taxSwitch.checked;

      for (let i = 0; i < basePrices.length; i++) {
        if (isChecked) {
          basePrices[i].classList.add("d-none");
          taxPrices[i].classList.remove("d-none");
        } else {
          basePrices[i].classList.remove("d-none");
          taxPrices[i].classList.add("d-none");
        }
      }

      for (let info of taxInfo) {
        if (isChecked) {
          info.style.display = "inline";
        } else {
          info.style.display = "none";
        }
      }
    });
  }

  const filters = document.getElementById("filters");
  const slideLeftBtn = document.getElementById("slideLeftBtn");
  const slideRightBtn = document.getElementById("slideRightBtn");

  if (filters && slideLeftBtn && slideRightBtn) {
    slideLeftBtn.addEventListener("click", () => {
      filters.scrollBy({ left: -260, behavior: "smooth" });
    });
    slideRightBtn.addEventListener("click", () => {
      filters.scrollBy({ left: 260, behavior: "smooth" });
    });
  }
</script>